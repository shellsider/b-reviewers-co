# Ignore virtual environment directories
venv/
.env/
.env 

# Ignore Firebase Admin SDK credentials (ensure the path matches the one you use)
firebase-admin-sdk.json

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore editor config files (e.g., VSCode, PyCharm, etc.)
.vscode/
.idea/

# Ignore macOS system files
.DS_Store

# Ignore Windows system files
Thumbs.db
desktop.ini

# Ignore log files
*.log

# Ignore Python build directories
build/
dist/
*.egg-info/

# Ignore test/coverage directories
.coverage
.tox/
.nox/
*.coveragerc
*.hypothesis/

# Ignore package manager lock files for Python
Pipfile.lock

# --- Node.js specific ignores below ---

# Node modules
node_modules/

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
lib/
build/
dist/
.tmp/
.temp/

# Coverage directory used by tools like istanbul
coverage/

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Parcel cache
.cache/

# Binaries
*.tsbuildinfo

# Logs
*.log
logs/

# OS generated files (if not already ignored above)
*.swo
*.swp
